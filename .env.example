# Copy to .env (bootstrap.sh does this for you and fills in RUNNER_TOKEN).
# Instructor account created in Gitea on first bootstrap.
ADMIN_USER=instructor
ADMIN_PASS=ChangeMe-Sandbox1
ADMIN_EMAIL=instructor@sandbox.local

# Gitea organisation that holds the lab repos; one org per cohort works well.
ORG=sandbox

# Filled in by scripts/bootstrap.sh — the runner's one-time registration token.
RUNNER_TOKEN=

# Shared secret for k3s nodes; any string.
K3S_TOKEN=sandbox-k3s-token

# Hosted platform only (leave unset on a laptop).
# Public address of Gitea behind the tunnel; also used for the links the tile shows.
#GITEA_ROOT_URL=https://devops-git.mubita.digital/
# Public base for learner apps; the agent creates a Traefik Ingress at <base>/<learner>/ on provision.
#APP_BASE_URL=https://devops-apps.mubita.digital
